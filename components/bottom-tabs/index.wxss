.bottom-tabs {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 30;
}

.tabs-shell {
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.96);
  border: 2rpx solid rgba(255, 138, 61, 0.14);
  box-shadow: 0 18rpx 40rpx rgba(106, 66, 20, 0.14);
  backdrop-filter: blur(14rpx);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 12rpx;
  border-radius: 999rpx;
  color: #7a8599;
  transition: all 180ms ease;
}

.tab-item--active {
  background: linear-gradient(135deg, #ff983f 0%, #ffbd59 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(255, 138, 61, 0.28);
}

.tab-icon {
  font-size: 28rpx;
  line-height: 1;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
}
