.chat-page {
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 300rpx;
  padding-top: 160rpx;
}

.chat-header {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: calc(env(safe-area-inset-top) + 24rpx);
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 250, 244, 0.86);
  border: 2rpx solid rgba(255, 138, 61, 0.14);
  backdrop-filter: blur(12rpx);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-avatar {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb55e 0%, #ff7c4d 50%, #5a9bff 100%);
  box-shadow: 0 12rpx 30rpx rgba(255, 138, 61, 0.22);
}

.brand-avatar__text {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.status-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(90, 155, 255, 0.12);
  color: var(--brand-blue);
  font-size: 22rpx;
  font-weight: 600;
}

.chat-board {
  overflow: hidden;
}

.board-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx 0;
}

.toolbar-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.toolbar-title {
  font-size: 30rpx;
  font-weight: 700;
}

.toolbar-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.toolbar-chip {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: var(--bg-soft-orange);
  color: var(--brand-orange-deep);
  font-size: 22rpx;
}

.message-scroll {
  height: calc(100vh - 454rpx);
  min-height: 720rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 28rpx 200rpx;
}

.history-anchor {
  align-self: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(242, 244, 247, 0.9);
  color: var(--text-secondary);
  font-size: 22rpx;
}

.message-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.message-row--user {
  align-items: flex-start;
}

.message-row--assistant {
  align-items: flex-end;
}

.bubble {
  max-width: 80%;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  word-break: break-word;
  white-space: pre-wrap;
  font-size: 30rpx;
  line-height: 1.5;
}

.bubble--user {
  background: var(--bg-soft-gray);
  color: var(--text-primary);
  border-top-left-radius: 10rpx;
}

.bubble--assistant {
  background: var(--bg-soft-blue);
  color: #214468;
  border-top-right-radius: 10rpx;
  box-shadow: var(--shadow-bubble);
}

.bubble--loading {
  min-width: 110rpx;
}

.bubble-text {
  display: block;
}

.message-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 4rpx;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(90, 155, 255, 0.7);
  animation: bounce 1.1s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.12s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.24s;
}

@keyframes bounce {
  0%,
  80%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }

  40% {
    opacity: 1;
    transform: translateY(-8rpx);
  }
}

.composer-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 25;
}

.composer {
  padding: 18rpx;
}

.input-wrap {
  padding: 6rpx 8rpx 2rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.composer-input {
  width: 100%;
  min-height: 88rpx;
  max-height: 220rpx;
  padding: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.composer-placeholder {
  color: var(--text-light);
}

.composer-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.record-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.send-button {
  min-width: 152rpx;
  height: 74rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a3d 0%, #5a9bff 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 74rpx;
}

.send-button::after {
  border: none;
}
