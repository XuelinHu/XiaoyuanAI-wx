<view class="page-shell profile-page">
  <view class="profile-hero card">
    <view class="profile-avatar">元</view>
    <view class="profile-copy">
      <text class="profile-name">我的</text>
      <text class="profile-subtitle">管理偏好、情绪陪伴方式与会话设置</text>
    </view>
  </view>

  <view class="profile-section">
    <view wx:for="{{items}}" wx:key="title" class="profile-item card">
      <view>
        <text class="profile-item__title">{{item.title}}</text>
        <text class="profile-item__desc">{{item.desc}}</text>
      </view>
      <text class="profile-item__action">{{item.action}}</text>
    </view>
  </view>

  <bottom-tabs current="profile" />
</view>
