.profile-page {
  padding: 24rpx 24rpx 180rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(255, 246, 235, 0.98) 0%, rgba(237, 245, 255, 0.98) 100%);
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9936 0%, #5a9bff 100%);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
}

.profile-subtitle {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.profile-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.profile-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 28rpx;
}

.profile-item__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.profile-item__desc {
  display: block;
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.profile-item__action {
  color: var(--brand-orange-deep);
  font-size: 24rpx;
  font-weight: 600;
}
